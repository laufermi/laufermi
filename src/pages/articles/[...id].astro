---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { publishedArticles, formatDate } from '../../data/articles';
export async function getStaticPaths() {
  return (await publishedArticles()).map(article => ({ params: { id: article.id }, props: { article } }));
}
const { article } = Astro.props;
const { Content, headings } = await render(article);
const toc = headings.filter(heading => heading.depth === 2);
---
<Base title={article.data.title} description={article.data.description} article>
  <meta slot="head" property="article:published_time" content={article.data.date.toISOString()} />
  <article>
    <header class="page-intro article-intro"><a class="text-link" href="/articles/">Back to articles</a><div class="article-meta"><time datetime={article.data.date.toISOString()}>{formatDate(article.data.date)}</time><span>{article.data.tags.join(' / ')}</span></div><h1>{article.data.title}</h1><p>{article.data.description}</p></header>
    <div class="reading-layout"><aside>{toc.length > 0 && <nav aria-label="On this page"><p class="section-label">On this page</p>{toc.map(heading => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav>}</aside><div class="prose"><Content /></div></div>
  </article>
</Base>
